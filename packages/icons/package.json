{
  "name": "@umc-product/icons",
  "version": "0.4.0",
  "description": "UMC 디자인 시스템 아이콘, 픽토그램, 로고 React 컴포넌트",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://umc-product.github.io/umc-product-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UMC-PRODUCT/umc-product-design-system.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "icons:build": "tsx scripts/build.ts",
    "icons:check": "tsx scripts/check.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.5"
  }
}
