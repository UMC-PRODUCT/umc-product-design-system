{
  "name": "@umc-product/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla-extract": {
      "types": "./dist/vanilla-extract.d.ts",
      "import": "./dist/vanilla-extract.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./base.css": "./dist/base.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "scripts": {
    "figma:inspect": "tsx scripts/inspect.ts",
    "tokens:normalize": "tsx scripts/normalize/index.ts",
    "tokens:build": "tsx scripts/build/index.ts",
    "tokens:check": "tsx scripts/build/check.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.2.2",
    "@types/node": "^22.15.0",
    "@vanilla-extract/css": "^1.21.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  }
}
