{
  "name": "@umc-product/design-tokens",
  "version": "0.11.1",
  "description": "UMC 디자인 시스템 토큰. CSS 변수, Tailwind v4 유틸리티, vanilla-extract 객체",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://umc-product.github.io/umc-product-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UMC-PRODUCT/umc-product-design-system.git",
    "directory": "packages/design-tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vanilla-extract": {
      "types": "./dist/vanilla-extract.d.ts",
      "import": "./dist/vanilla-extract.js",
      "default": "./dist/vanilla-extract.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./base.css": "./dist/base.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "figma:inspect": "tsx scripts/inspect.ts",
    "tokens:normalize": "tsx scripts/normalize/index.ts",
    "tokens:build": "tsx scripts/build/index.ts",
    "tokens:check": "tsx scripts/build/check.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.2.2",
    "@types/node": "^22.15.0",
    "@vanilla-extract/css": "^1.21.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  }
}
