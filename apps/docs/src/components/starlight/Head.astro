---
import Default from "@astrojs/starlight/components/Head.astro"
---

<Default />

<script>
  import { applyCodeTooltips } from "../../scripts/code-tooltips.ts"
  import { applyForcedStates } from "../../scripts/forced-states.ts"

  applyCodeTooltips()

  if (document.readyState === "complete") {
    applyForcedStates()
  } else {
    window.addEventListener("load", applyForcedStates, { once: true })
  }
</script>
