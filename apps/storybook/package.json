{
  "name": "@umc-product/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w run build:packages && storybook dev -p 6006",
    "build": "pnpm -w run build:packages && storybook build --output-dir storybook-static",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@umc-product/design-tokens": "workspace:*",
    "@umc-product/icons": "workspace:*",
    "@umc-product/react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^30.1.2",
    "storybook": "10.6.1",
    "storybook-addon-pseudo-states": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  }
}
